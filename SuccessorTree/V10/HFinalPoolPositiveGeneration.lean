import SuccessorTree.V10.HHigherPoolCumulativeBound
import SuccessorTree.V10.HFinitePartial
import Mathlib.Tactic

/-!
# V10 Proposition 6.44: every positive-cut retained original is real

The fixed final original-name pool V contains one distinguished root
c and all selected addresses with positive E-free cut. To close the
manuscript's induction, its cardinal must be bounded by the root
plus the real selected positive-generation levels.

This is a statement about the ACTUAL E relation of the finite H
constructor. If the free cut of v is positive, E(0,v) holds.
The complete generated E definition forces the target v to have
a bounded real numerical address iota(j,m), and the generator
gate forces m>0. Hence each selected nonroot member of V is
an actual selected positive-generation level, not an unknown
fake original or a fresh representative of the same type.

These are literal Fin N addresses throughout. Together with
the already checked cardinal union of generation-m address
sets, this gives the clean global estimate

  |V| <= 1 + sum_{m=1}^k |selected real generation-m levels|.

It does not assume a future bound M or a new E on an L-only age
witness.
-/

namespace SuccessorTree.V10

/-- Every actual positive free E-cut is generated by a real H
target of strictly positive generation. -/
theorem finiteNumericH_positive_freeCut_has_real_positive_generation
    {db du dd : Nat}
    (K : AgeTestModel db du dd)
    (k N : Nat) (hk : 0 < k)
    (v : Fin N)
    (hPos : 0 < (finiteNumericH K k N).freeLevel v.val) :
    ∃ j m : Nat, 0 < m ∧ m ≤ k ∧
      v.val = hPosition k j m := by
  let A : EnumeratedPartialStructure db du dd := finiteNumericH K k N
  have hE : A.E 0 v.val = true :=
    (A.E_iff_freeLevel 0 v.val).2 (by exact hPos)
  have hFinite : finiteNumericHE k N 0 v.val = true := hE
  obtain ⟨_hVN,hExact⟩ :=
    (finiteNumericHE_true_iff k N 0 v.val).1 hFinite
  obtain ⟨j,m,hmLe,hAddress,hGenerated⟩ :=
    (exactHEBool_true_iff k 0 v.val).1 hExact
  have hmPos : 0 < m :=
    generatedE_positive_source_generation k j m 0 hk hGenerated
  exact ⟨j,m,hmPos,hmLe,hAddress⟩

/-- The literal final stage original pool consists only of the
distinguished c and selected REAL originals of positive
generation. No quotienting by partial types is performed. -/
theorem numericH_stage_originals_subset_root_or_real_selected
    {db du dd : Nat}
    (family : List (NormalizedForbidden db du dd))
    (K : AgeTestModel db du dd)
    (k N : Nat) (hk : 0 < k)
    (c : Fin N)
    (X : Set (AdmissibleKptNode family))
    (R : SMTree.Envelope.AlgorithmRun
      (normalizedKptSMTree family) X
      ((finiteNumericH K k N).freeLevel c.val)) :
    hStageOriginals K k N ({c} : Finset (Fin N)) (R.I 0) ⊆
      ({c} : Finset (Fin N)) ∪
        numericHSelectedHigherAddresses family K k N c X R 0 := by
  classical
  intro v hv
  have hv' :
      v ∈ ({c} : Finset (Fin N)) ∨
      (v.val ∈ R.I 0 ∧
        0 < (finiteNumericH K k N).freeLevel v.val) := by
    simpa only [hStageOriginals, Finset.mem_filter,
      Finset.mem_univ, true_and] using hv
  rcases hv' with hRoot | ⟨hSelected,hPos⟩
  · exact Finset.mem_union.mpr (Or.inl hRoot)
  · obtain ⟨j,m,hmPos,hmLe,hReal⟩ :=
      finiteNumericH_positive_freeCut_has_real_positive_generation
        K k N hk v hPos
    apply Finset.mem_union.mpr
    right
    change v ∈ (Finset.univ : Finset (Fin N)).filter
      (fun w => w.val ∈ R.I 0 ∧
        ∃ j m : Nat, 0 < m ∧ m ≤ k ∧
          w.val = hPosition k j m)
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_univ _,hSelected,j,m,hmPos,hmLe,hReal⟩

/-- The full finite stage pool is charged to one root plus
actual previously selected positive-generation real addresses.
The sharp numerical envelope recurrence controls this sum. -/
theorem numericH_stage_originals_card_le_root_plus_selected
    {db du dd : Nat}
    (family : List (NormalizedForbidden db du dd))
    (K : AgeTestModel db du dd)
    (k N : Nat) (hk : 0 < k)
    (c : Fin N)
    (X : Set (AdmissibleKptNode family))
    (R : SMTree.Envelope.AlgorithmRun
      (normalizedKptSMTree family) X
      ((finiteNumericH K k N).freeLevel c.val)) :
    (hStageOriginals K k N
      ({c} : Finset (Fin N)) (R.I 0)).card ≤
      1 + ∑ m ∈ Finset.Icc 1 k,
        (numericHSelectedRealGenerationLevels
          family K k N c X R m).card := by
  classical
  let B : Finset (Fin N) :=
    numericHSelectedHigherAddresses family K k N c X R 0
  let Gen : Nat → Finset (Fin N) := fun m =>
    numericHSelectedGenerationAddresses k N m (R.I 0)
  have hBSub : B ⊆ (Finset.Icc 1 k).biUnion Gen :=
    numericHSelectedHigherAddresses_subset_generationUnion
      family K k N c X R 0
  have hBCard :
      B.card ≤ ∑ m ∈ Finset.Icc 1 k,
        (numericHSelectedRealGenerationLevels
          family K k N c X R m).card := by
    calc
      B.card ≤ ((Finset.Icc 1 k).biUnion Gen).card :=
        Finset.card_le_card hBSub
      _ ≤ ∑ m ∈ Finset.Icc 1 k, (Gen m).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ m ∈ Finset.Icc 1 k,
          (numericHSelectedRealGenerationLevels
            family K k N c X R m).card := by
        apply Finset.sum_le_sum
        intro m hm
        exact numericHSelectedGenerationAddresses_card_le_levels
          family K k N c X R m
  have hVSub :
      hStageOriginals K k N
        ({c} : Finset (Fin N)) (R.I 0) ⊆
      ({c} : Finset (Fin N)) ∪ B :=
    numericH_stage_originals_subset_root_or_real_selected
      family K k N hk c X R
  calc
    (hStageOriginals K k N
      ({c} : Finset (Fin N)) (R.I 0)).card
      ≤ (({c} : Finset (Fin N)) ∪ B).card :=
        Finset.card_le_card hVSub
    _ ≤ 1 + B.card := by
      simpa using Finset.card_union_le
        ({c} : Finset (Fin N)) B
    _ ≤ 1 + ∑ m ∈ Finset.Icc 1 k,
        (numericHSelectedRealGenerationLevels
          family K k N c X R m).card :=
      Nat.add_le_add_left hBCard 1

end SuccessorTree.V10