import SuccessorTree.V10.KptForestMeetBound
import SuccessorTree.V10.I3AlgorithmRunPool
import SuccessorTree.V10.HTopGenerationSeeds
import SuccessorTree.EnvelopeHeight
import Mathlib.Tactic

/-!
# V10 Proposition 6.44: final sharp envelope-level count

For the actual normalized Kpt Algorithm 5.4 run on the literal
top-generation seed family X, retain one finite final original
pool V = {c} union selected positive-free-cut addresses.

The final closure is generated by seed nodes and the full
types of V, so the new exact forest 2N lemma bounds its
node levels by 2(|X|+|V|). Every selected level of I1 or I2
is represented by a node of that FINAL closure: the closure
at a tested stage is contained in the final closure because
its selected parameter levels form a subset of the final set.

All remaining positive selected levels are genuine I3 stages;
the already-checked actual-run finite signature theorem bounds
them by R(|V|), with no invented finite age witness or E data.
Level zero contributes at most one.

Consequently the *actual* selected envelope levels satisfy

  |I| <= 2(q+1+|V|) + R(|V|) + 1

where q is the number of prescribed top-generation seed-prefix
positions. It remains to substitute the uniform bound |V|<=M
from the downward real-generation induction to close the
exact Proposition 6.44 numerical bound.
-/

namespace SuccessorTree.V10

/-- Parameter-set monotonicity of the ACTUAL least closure,
derived directly from its universal definition. -/
private theorem actualKptClosure_mono_params
    {db du dd : Nat}
    (family : List (NormalizedForbidden db du dd))
    {I J : Set Nat} (hIJ : I ⊆ J)
    (X : Set (AdmissibleKptNode family)) :
    SMTree.Envelope.closure (admissibleKptSTree family) I X ⊆
      SMTree.Envelope.closure (admissibleKptSTree family) J X := by
  intro z hz Y hXY hMeet hParamJ
  have hParamI : SMTree.Envelope.ParameterClosedOver
      (admissibleKptSTree family) Y I := by
    intro a ha i hi hia p c hstep v hv
    exact hParamJ ha (hIJ hi) hia hstep hv
  exact hz Y hXY hMeet hParamI

/-- The final finite selected levels are read directly from
the AlgorithmRun, independently of any auxiliary family of
I3 signatures or meet levels. -/
noncomputable def numericHRunFinalSelectedLevels
    {db du dd : Nat}
    (family : List (NormalizedForbidden db du dd))
    (K : AgeTestModel db du dd)
    (k N : Nat) (c : Fin N)
    (X : Set (AdmissibleKptNode family))
    (R : SMTree.Envelope.AlgorithmRun
      (normalizedKptSMTree family) X
      ((finiteNumericH K k N).freeLevel c.val)) :
    Finset Nat := by
  classical
  exact (Finset.range ((finiteNumericH K k N).freeLevel c.val+1)).filter
    (fun ell => ell ∈ R.I 0)

/-- Genuine end-to-end bound on the ACTUAL selected levels of
the normalized finite H envelope run, in terms of the number
of retained original addresses in its final fixed pool. -/
theorem numericHTopSeeds_finalRun_selected_card_le_sharp
    {db du dd : Nat}
    (family : List (NormalizedForbidden db du dd))
    (K : AgeTestModel db du dd)
    (hCarrier : ∀ i : Nat, i ∈ K.carrier)
    (hAvoidK : ∀ bad, bad ∈ family → bad.Avoids K)
    (k N : Nat)
    (c : Fin N) (blocks : Finset Nat)
    (hWithin : ∀ i : Nat, i ∈ blocks →
      hPosition k i k ≤ (finiteNumericH K k N).freeLevel c.val)
    (R : SMTree.Envelope.AlgorithmRun
      (normalizedKptSMTree family)
      (numericHTopGenerationSeeds family K k N
        (finiteNumericH_avoids_family family K hCarrier k N hAvoidK)
        c blocks hWithin)
      ((finiteNumericH K k N).freeLevel c.val)) :
    (numericHRunFinalSelectedLevels family K k N c
      (numericHTopGenerationSeeds family K k N
        (finiteNumericH_avoids_family family K hCarrier k N hAvoidK)
        c blocks hWithin :
        Set (AdmissibleKptNode family)) R).card ≤
      2 * (blocks.card + 1 +
        (hStageOriginals K k N ({c} : Finset (Fin N)) (R.I 0)).card) +
      ageSignatureCapacity
        (fun i : Fin family.length => (family.get i).patternCard)
        (hStageOriginals K k N ({c} : Finset (Fin N)) (R.I 0)).card +
      1 := by
  classical
  let A : EnumeratedPartialStructure db du dd := finiteNumericH K k N
  let hAvoidA : ∀ bad, bad ∈ family → bad.Avoids A.L :=
    finiteNumericH_avoids_family family K hCarrier k N hAvoidK
  let Xfin : Finset (AdmissibleKptNode family) :=
    numericHTopGenerationSeeds family K k N hAvoidA c blocks hWithin
  let X : Set (AdmissibleKptNode family) := Xfin
  let U : Finset (Fin N) := {c}
  let V : Finset (Fin N) :=
    hStageOriginals K k N ({c} : Finset (Fin N)) (R.I 0)
  let top : Nat := A.freeLevel c.val
  let S : Finset Nat :=
    numericHRunFinalSelectedLevels family K k N c X R
  let P : Finset (AdmissibleKptNode family) :=
    finiteKptClosureGeneratorPool family A hAvoidA Xfin V
  let F : Finset Nat := (forestFiniteMeetNodes P).image LevelTree.lev
  let Z : Nat → Set (AdmissibleKptNode family) :=
    fun ell => SMTree.Envelope.closure
      (admissibleKptSTree family) (R.I (ell+1)) X
  let Event : Nat → Prop := fun ell =>
    (∃ z : AdmissibleKptNode family,
      z ∈ Z ell ∧ LevelTree.lev z = ell) ∨
    (∃ a : AdmissibleKptNode family, a ∈ Z ell ∧
      ∃ b : AdmissibleKptNode family, b ∈ Z ell ∧
        SMTree.Envelope.SameComponent a b ∧
        LevelTree.lev (LevelTree.meet a b) = ell)
  let T : Finset Nat := S.filter (fun ell => 0 < ell ∧ ¬ Event ell)
  have hSeeds : X ⊆ ambientPrefixPool family A hAvoidA
      (U : Set (Fin A.size)) := by
    have hSingleton :
        (↑U : Set (Fin N)) = ({c} : Set (Fin N)) := by
      ext v
      simp [U]
    change (↑(numericHTopGenerationSeeds family K k N
        hAvoidA c blocks hWithin) : Set (AdmissibleKptNode family)) ⊆
      ambientPrefixPool family (finiteNumericH K k N)
        hAvoidA (↑U : Set (Fin N))
    rw [hSingleton]
    exact numericHTopGenerationSeeds_subset_rootPool
      family K k N hAvoidA c blocks hWithin
  have hUV : U ⊆ V := by
    intro i hi
    have hName : i ∈ ({c} : Finset (Fin N)) := by
      change i ∈ ({c} : Finset (Fin N)) at hi
      exact hi
    have hMem :
        i ∈ hStageOriginals K k N
          ({c} : Finset (Fin N)) (R.I 0) := by
      simp [hStageOriginals, hName]
    exact hMem
  have hParams : ∀ i : Fin A.size, i.val ∈ R.I 0 →
      0 < A.freeLevel i.val → i ∈ V := by
    intro i hi hFree
    have hMem :
        i ∈ hStageOriginals K k N
          ({c} : Finset (Fin N)) (R.I 0) := by
      simp [hStageOriginals, hi, hFree]
    exact hMem
  have hForest :
      SMTree.Envelope.closure (admissibleKptSTree family)
        (R.I 0) X ⊆ (forestFiniteMeetNodes P :
          Set (AdmissibleKptNode family)) :=
    actualKptStageClosure_subset_forestMeetNodes
      family A hAvoidA (R.I 0) Xfin U V hSeeds hUV hParams
  have hForestCard : F.card ≤ 2 * (Xfin.card + V.card) :=
    finiteKptClosureGeneratorPool_levels_card_le
      family A hAvoidA Xfin V
  have hRootSeed :
      A.kptOriginal family hAvoidA c ∈ X := by
    change (A.kptOriginal family hAvoidA c) ∈
      numericHTopGenerationSeeds family K k N hAvoidA
        c blocks hWithin
    unfold numericHTopGenerationSeeds
    exact Finset.mem_insert.mpr (Or.inl (by dsimp [A]))
  have hTop : ∃ z ∈ X, LevelTree.lev z = top :=
    ⟨A.kptOriginal family hAvoidA c,hRootSeed,rfl⟩
  have hSelected :
      ∀ ell, ell ∈ S → ell ∈ R.I 0 := by
    intro ell hEll
    change ell ∈
      (Finset.range (top+1)).filter (fun q => q ∈ R.I 0) at hEll
    exact (Finset.mem_filter.mp hEll).2
  have hLevelLe :
      ∀ ell, ell ∈ S → ell ≤ top := by
    intro ell hEll
    exact (R.I_mem_bounds 0 (Nat.zero_le top) ell
      (hSelected ell hEll)).2
  have hStageSub :
      ∀ ell, ell < top → Z ell ⊆
        SMTree.Envelope.closure (admissibleKptSTree family)
          (R.I 0) X := by
    intro ell hLt
    have hTail : R.I (ell+1) ⊆ R.I 0 := by
      intro q hq
      have hBound :
          ell + 1 ≤ (finiteNumericH K k N).freeLevel c.val := by
        change ell < (finiteNumericH K k N).freeLevel c.val at hLt
        omega
      have hEq := R.I_eq_final_tail_of_run (ell+1) hBound
      rw [hEq] at hq
      exact hq.1
    exact actualKptClosure_mono_params family hTail X
  have hEventF :
      ∀ ell, ell ∈ S → Event ell → ell ∈ F := by
    intro ell hSel hEvent
    have hInFinal :
        ∃ z, z ∈ SMTree.Envelope.closure
          (admissibleKptSTree family) (R.I 0) X ∧
          LevelTree.lev z = ell := by
      by_cases hTopIndex : ell = top
      · refine ⟨A.kptOriginal family hAvoidA c,
          SMTree.Envelope.subset_closure
            (admissibleKptSTree family) (R.I 0) X hRootSeed,?_⟩
        rw [hTopIndex]
        rfl
      · have hLt : ell < top := by
          have hLe := hLevelLe ell hSel
          omega
        have hSub := hStageSub ell hLt
        rcases hEvent with ⟨z,hz,hLev⟩ |
          ⟨a,ha,b,hb,hCommon,hLev⟩
        · exact ⟨z,hSub hz,hLev⟩
        · have hMeet :
              LevelTree.meet a b ∈ Z ell :=
            SMTree.Envelope.closure_meetClosed
              (admissibleKptSTree family) (R.I (ell+1)) X
              ha hb hCommon
          exact ⟨LevelTree.meet a b,hSub hMeet,hLev⟩
    obtain ⟨z,hz,hLev⟩ := hInFinal
    have hzP : z ∈ forestFiniteMeetNodes P := hForest hz
    exact Finset.mem_image.mpr ⟨z,hzP,hLev⟩
  have hTLevels : ∀ ell, ell ∈ T →
      0 < ell ∧ ell < top ∧ ell < N ∧ ell ∈ R.I 0 := by
    intro ell hMem
    obtain ⟨hS,hPositive,hNoEvent⟩ := Finset.mem_filter.mp hMem
    have hBound := hLevelLe ell hS
    have hLt : ell < top := by
      by_contra hnot
      have heq : ell = top := by omega
      have hEventTop : Event ell := by
        left
        exact ⟨A.kptOriginal family hAvoidA c,
          SMTree.Envelope.subset_closure
            (admissibleKptSTree family) (R.I (ell+1)) X
            hRootSeed,by rw [heq]; rfl⟩
      exact hNoEvent hEventTop
    have hFreeLe : top ≤ c.val := A.freeLevel_le c.val
    have hN : ell < N := by
      have hc := c.isLt
      omega
    exact ⟨hPositive,hLt,hN,hSelected ell hS⟩
  have hAge :
      T.card ≤ ageSignatureCapacity
        (fun i : Fin family.length => (family.get i).patternCard)
        V.card := by
    apply numericH_algorithmRun_I3_card_le_finalPoolCapacity
      family K hCarrier hAvoidK k N
      ({c} : Finset (Fin N)) X hSeeds top R hTop T
    · exact hTLevels
    · intro ell hMem hI1
      exact (Finset.mem_filter.mp hMem).2.2 (Or.inl hI1)
    · intro ell hMem hI2
      exact (Finset.mem_filter.mp hMem).2.2 (Or.inr hI2)
  have hCover : S ⊆ (F ∪ T) ∪ {0} := by
    intro ell hMem
    by_cases hZero : ell = 0
    · exact Finset.mem_union.mpr
        (Or.inr (Finset.mem_singleton.mpr hZero))
    · by_cases hEvent : Event ell
      · exact Finset.mem_union.mpr
          (Or.inl (Finset.mem_union.mpr
            (Or.inl (hEventF ell hMem hEvent))))
      · have hPos : 0 < ell := by omega
        have hT : ell ∈ T :=
          Finset.mem_filter.mpr ⟨hMem,hPos,hEvent⟩
        exact Finset.mem_union.mpr
          (Or.inl (Finset.mem_union.mpr (Or.inr hT)))
  have hSeedsCard : Xfin.card ≤ blocks.card + 1 :=
    numericHTopGenerationSeeds_card_le
      family K k N hAvoidA c blocks hWithin
  calc
    S.card ≤ ((F ∪ T) ∪ ({0} : Finset Nat)).card :=
      Finset.card_le_card hCover
    _ ≤ F.card + T.card + 1 := by
      have hA := Finset.card_union_le F T
      have hB := Finset.card_union_le (F ∪ T) ({0} : Finset Nat)
      simp only [Finset.card_singleton] at hB
      omega
    _ ≤ 2 * (blocks.card+1+V.card) +
        ageSignatureCapacity
          (fun i : Fin family.length => (family.get i).patternCard)
          V.card + 1 := by omega

end SuccessorTree.V10