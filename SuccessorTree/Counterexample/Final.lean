import SuccessorTree.Counterexample.ConcreteAntichain
import SuccessorTree.Counterexample.Topology
import Mathlib.Topology.GDelta.Basic

/-!
# A closed nowhere-dense non-Ramsey-null set in the free shape-map monoid

This is the exact direct-monoid topological counterexample to the
original successor-tree Theorem 1.11.

The topology is generated by right-composition neighborhoods [a,F]
of the direct M-map approximation system. We use the finite root
map f(root) = first successor; for every pure map H fixing source
levels 0 and 1, the basic neighborhood [f,H] contains an element of
the constructed closed nowhere-dense set Z.

All quantified objects are actual shape-preserving M-maps of the
M1--M3 free-ancestral instance, not fat trees.

In particular, the counterexample defeats Ramsey-nullity without
assuming any direct A.3(2) amalgamation axiom.
-/

namespace SuccessorTree.Counterexample

open SuccessorTree.FreeAncestral
open SuccessorTree.SMTree

/-- The paper's root-based basic neighborhood [f,H], expressed
without an approximation-index off-by-one convention. Its members
factor on the right through H and send the original root to the
unique level-one successor. -/
def RootNeighborhood (H : ExampleMap) : Set ExampleMap :=
  {G | SMTree.RamseyReduction markerMonoid G H ∧
    G (rootNode (Label := Unit) (arity := 1)) = markedFirstNode}

/-- Ramsey-nullity at this particular nonempty finite approximation
would require some pure refinement of [f,Id] avoiding the target.
The counterexample gives its negation. -/
def AvoidableAtRoot (Z : Set ExampleMap) : Prop :=
  ∃ H : PureFreeMap, Disjoint (RootNeighborhood H.val) Z

/-- A direct translation of the infinitary antichain construction
into the **actual Ellentuck topology of the shape-map monoid**:
there is a closed nowhere-dense set meeting *every* pure
right-composition refinement of the root-based neighborhood.

The continuum-sized greedy recursion uses only ZFC and never assumes
that 2^ℵ₀ is regular. -/
theorem exists_closed_nowhereDense_not_avoidable :
    ∃ Z : Set ExampleMap,
      @IsClosed ExampleMap
        (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology Z ∧
      @IsNowhereDense ExampleMap
        (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology Z ∧
      ¬ AvoidableAtRoot Z := by
  classical
  letI : TopologicalSpace ExampleMap :=
    (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology
  obtain ⟨N, hN, hMeet⟩ :=
    exists_pure_meeting_incompatible_family
  have hND : IsNowhereDense N :=
    SMTree.incompatible_family_isNowhereDense
      markerMonoid N hN freeAncestral_hasLateProperGaps
  refine ⟨closure N, isClosed_closure, hND.closure, ?_⟩
  rintro ⟨H, havoid⟩
  obtain ⟨F, hF, hred, hroot⟩ := hMeet H
  have hcone : F ∈ RootNeighborhood H.val := ⟨hred, hroot⟩
  have hZ : F ∈ closure N := subset_closure hF
  exact (Set.disjoint_left.mp havoid) hcone hZ

/-- In particular the direct monoid topology has a nowhere-dense
set which is **not Ramsey null** in the paper's original root
neighborhood. This is stronger than the failure of the fat-tree
projection proof. -/
theorem exists_nowhereDense_hits_every_pure :
    ∃ Z : Set ExampleMap,
      @IsNowhereDense ExampleMap
        (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology Z ∧
      ∀ H : PureFreeMap,
        (RootNeighborhood H.val ∩ Z).Nonempty := by
  obtain ⟨Z, _, hnd, hna⟩ :=
    exists_closed_nowhereDense_not_avoidable
  refine ⟨Z, hnd, ?_⟩
  intro H
  by_contra hne
  apply hna
  refine ⟨H, ?_⟩
  apply disjoint_iff_inf_le.mpr
  intro F hF
  exact hne ⟨F, hF⟩

/-- Literal meagreness formulation of the paper's failure:
in the direct monoid Ellentuck topology there is a meagre set
which no depth-preserving pure refinement of the selected root
neighborhood can avoid.

The proof is only a topological corollary of the already checked
closed nowhere-dense counterexample. The author's pure-refinement
definition is deliberately retained, rather than silently replaced
by the weaker arbitrary-basic-neighborhood definition. -/
theorem exists_meagre_not_avoidable :
    ∃ Z : Set ExampleMap,
      @IsMeagre ExampleMap
        (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology Z ∧
      ¬ AvoidableAtRoot Z := by
  letI : TopologicalSpace ExampleMap :=
    (SMTree.ramseyApproximationSystem markerMonoid).ellentuckTopology
  obtain ⟨Z, _, hNowhereDense, hNotAvoidable⟩ :=
    exists_closed_nowhereDense_not_avoidable
  exact ⟨Z, hNowhereDense.isMeagre, hNotAvoidable⟩

end SuccessorTree.Counterexample
